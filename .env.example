# --------------------------------------------------------------------
# ForgeMind AI — environment template
# Values marked "VERIFIED" were confirmed working on 2026-05-21 against
# Subhendu's TrueFoundry workspace.
# --------------------------------------------------------------------

ENVIRONMENT=dev
LOG_LEVEL=INFO
LLM_PROVIDER=truefoundry
AGENT_CONFIG_PATH=/app/.runtime/agent_config.json

POSTGRES_DSN=postgresql+asyncpg://forgemind:forgemind@postgres:5432/forgemind
REDIS_URL=redis://redis:6379/0

NATS_URL=nats://nats:4222
TELEMETRY_SUBJECT=forgemind.telemetry
INCIDENTS_SUBJECT=forgemind.incidents

# TrueFoundry AI Gateway -------------------------------------------------
# Optional. Use LLM_PROVIDER=openai or openai-compatible to run without it.
TFY_GATEWAY_BASE_URL=https://gateway.truefoundry.ai
TFY_GATEWAY_API_KEY=
TFY_WORKSPACE=forgemind
TFY_MCP_ENABLED=false

# Tier mapping. These point at concrete models registered in the gateway.
# VERIFIED: openai-main/gpt-4o-mini responded in ~700ms.
TFY_MODEL_FAST=openai-main/gpt-4o-mini
TFY_MODEL_POWERFUL=openai-main/gpt-4o
TFY_MODEL_EMBEDDING=openai-main/text-embedding-3-small
TFY_MODEL_FALLBACK=test-anthropic/claude-3-5-haiku-20241022

# Direct OpenAI / OpenAI-compatible defaults ----------------------------
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_POWERFUL=gpt-4o
OPENAI_MODEL_EMBEDDING=text-embedding-3-small
OPENAI_MODEL_FALLBACK=gpt-4o-mini

JWT_SECRET=change-me-please
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

OTEL_EXPORTER_ENDPOINT=http://otel-collector:4317

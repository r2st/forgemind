# --------------------------------------------------------------------
# ForgeMind AI — environment template
# --------------------------------------------------------------------

ENVIRONMENT=dev
LOG_LEVEL=INFO
LLM_PROVIDER=openai-compatible
AGENT_CONFIG_PATH=/app/.runtime/agent_config.json

POSTGRES_DSN=postgresql+asyncpg://forgemind:forgemind@postgres:5432/forgemind
REDIS_URL=redis://redis:6379/0

NATS_URL=nats://nats:4222
TELEMETRY_SUBJECT=forgemind.telemetry
INCIDENTS_SUBJECT=forgemind.incidents

# OpenAI-compatible defaults -------------------------------------------
# These can also be set from the Admin Panel globally or per agent.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_POWERFUL=gpt-4o
OPENAI_MODEL_EMBEDDING=text-embedding-3-small
OPENAI_MODEL_FALLBACK=gpt-4o-mini

JWT_SECRET=change-me-please
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

OTEL_EXPORTER_ENDPOINT=http://otel-collector:4317

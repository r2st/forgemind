# --------------------------------------------------------------------
# ForgeMind AI — environment template
# --------------------------------------------------------------------

ENVIRONMENT=dev
LOG_LEVEL=INFO
LLM_PROVIDER=openai-compatible
AGENT_CONFIG_PATH=/app/.runtime/agent_config.json

# Database credentials (REQUIRED: set secure values in production)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=forgemind
POSTGRES_DSN=postgresql+asyncpg://postgres:CHANGE_ME_STRONG_PASSWORD@postgres:5432/forgemind

REDIS_URL=redis://redis:6379/0

NATS_URL=nats://nats:4222
TELEMETRY_SUBJECT=forgemind.telemetry
INCIDENTS_SUBJECT=forgemind.incidents

# OpenAI-compatible defaults -------------------------------------------
# These can also be set from the Admin Panel globally or per agent.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_POWERFUL=gpt-4o
OPENAI_MODEL_EMBEDDING=text-embedding-3-small
OPENAI_MODEL_FALLBACK=gpt-4o-mini

# Security credentials (REQUIRED: generate strong secrets)
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=CHANGE_ME_RANDOM_SECRET_32_CHARS_MIN
GATEWAY_SECRET_KEY=  # Will auto-generate in dev if not set

# User authentication — BOOTSTRAP credentials.
# These let the stack come up with a working login on day one. Once an
# admin opens the Admin Panel → Users tab and edits/adds users there,
# the persistent store takes precedence. Hashes (bcrypt) are stored on
# the agent-config volume; users in the store survive restarts.
AUTH_ADMIN_USER=admin
AUTH_ADMIN_PASS=CHANGE_ME_ADMIN_PASSWORD
AUTH_ENGINEER_USER=engineer
AUTH_ENGINEER_PASS=CHANGE_ME_ENGINEER_PASSWORD
AUTH_OPERATOR_USER=operator
AUTH_OPERATOR_PASS=CHANGE_ME_OPERATOR_PASSWORD
AUTH_VIEWER_USER=viewer
AUTH_VIEWER_PASS=CHANGE_ME_VIEWER_PASSWORD

# CORS configuration (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Grafana admin credentials (REQUIRED)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

OTEL_EXPORTER_ENDPOINT=http://otel-collector:4317

# --------------------------------------------------------------------
# ForgeMind AI — environment template
# Copy to .env and edit. Never commit real secrets.
# --------------------------------------------------------------------

ENVIRONMENT=dev
LOG_LEVEL=INFO

# Persistence
POSTGRES_DSN=postgresql+asyncpg://forgemind:forgemind@postgres:5432/forgemind
REDIS_URL=redis://redis:6379/0

# Streaming
NATS_URL=nats://nats:4222
TELEMETRY_SUBJECT=forgemind.telemetry
INCIDENTS_SUBJECT=forgemind.incidents

# TrueFoundry AI Gateway -------------------------------------------------
# Get these from your TrueFoundry workspace settings.
TFY_GATEWAY_BASE_URL=https://llm-gateway.truefoundry.com
TFY_GATEWAY_API_KEY=replace-with-tfy-personal-access-token
TFY_WORKSPACE=forgemind

# Logical tier -> provider/model. The gateway uses these to pick a
# concrete deployment based on routing.yaml.
TFY_MODEL_FAST=openai-main/gpt-4o-mini
TFY_MODEL_POWERFUL=anthropic-main/claude-sonnet-4-5
TFY_MODEL_EMBEDDING=openai-main/text-embedding-3-small
TFY_MODEL_FALLBACK=ollama-local/llama3.1:8b

# Auth
JWT_SECRET=change-me-please
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# Observability
OTEL_EXPORTER_ENDPOINT=http://otel-collector:4317

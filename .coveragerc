[run]
# Trace threads + greenlets so FastAPI/anyio's request-dispatch workers
# don't hide handler coverage.
concurrency = thread,greenlet
parallel = True
branch = False
source =
    shared/forgemind_common
    services

[report]
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    raise NotImplementedError
    if TYPE_CHECKING:

{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 0,
  "panels": [
    {
      "type": "stat",
      "title": "HTTP requests (rate, last 5m)",
      "datasource": "Prometheus",
      "targets": [{"expr": "sum by (service) (rate(forgemind_http_requests_total[5m]))", "legendFormat": "{{service}}"}],
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 6}
    },
    {
      "type": "stat",
      "title": "LLM cost USD (cumulative)",
      "datasource": "Prometheus",
      "targets": [{"expr": "sum(forgemind_llm_cost_usd)", "legendFormat": "total"}],
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 6}
    },
    {
      "type": "stat",
      "title": "LLM tokens (rate, last 5m)",
      "datasource": "Prometheus",
      "targets": [{"expr": "sum(rate(forgemind_llm_tokens_total[5m]))", "legendFormat": "tok/s"}],
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 6}
    },
    {
      "type": "timeseries",
      "title": "Anomalies by severity",
      "datasource": "Prometheus",
      "targets": [{"expr": "sum by (severity) (rate(forgemind_anomalies_total[5m]))", "legendFormat": "{{severity}}"}],
      "gridPos": {"x": 0, "y": 6, "w": 24, "h": 8}
    },
    {
      "type": "timeseries",
      "title": "Request latency p95 by service",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (service, le) (rate(forgemind_http_request_seconds_bucket[5m])))",
          "legendFormat": "p95 {{service}}"
        }
      ],
      "gridPos": {"x": 0, "y": 14, "w": 24, "h": 8}
    }
  ],
